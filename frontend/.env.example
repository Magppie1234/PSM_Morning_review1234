# PSM Morning Review web app — copy to .env.local if you need to change a default. Every value here is
# built into the public JavaScript, so never put secrets in this file.

# API address. Leave empty: in development Vite forwards /api to the backend, and in production the
# backend serves this app. Set it only if the API runs on a different domain.
VITE_API_URL=

# Backend address the dev server forwards /api to.
VITE_DEV_API_TARGET=http://127.0.0.1:4010

# Zoho CRM web address used for "open this record" links (crm.zoho.in/crm/org<ORG_ID>).
VITE_ZOHO_CRM_URL=https://crm.zoho.in/crm/org60046349006
