# PSM Morning Review API — copy this file to .env and fill in the values.
# Never commit .env. In production set these as the host's environment variables instead.

# --- Zoho CRM (required) ---------------------------------------------------------------
# From the Zoho API console (api-console.zoho.in). The refresh token needs ZohoCRM.modules.ALL,
# ZohoCRM.settings.ALL and ZohoCRM.users.ALL.
ZOHO_CLIENT_ID=replace_with_zoho_client_id
ZOHO_CLIENT_SECRET=replace_with_zoho_client_secret
ZOHO_REFRESH_TOKEN=replace_with_zoho_refresh_token
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in
ZOHO_ORG_ID=replace_with_zoho_org_id
ZOHO_LEADS_MODULE=Leads
ZOHO_DASHBOARD_TIMEZONE=Asia/Kolkata

# --- Server ------------------------------------------------------------------------------
# NODE_ENV=production listens on all interfaces and serves frontend/dist from this server.
NODE_ENV=development
PORT=4010
# HOST=127.0.0.1
# Browser origins allowed to call the API (comma-separated). Needed only when the frontend is served
# from a different address, e.g. the Vite dev server. Leave empty in production (same origin).
CORS_ORIGIN=http://127.0.0.1:5174,http://localhost:5174

# --- Sign-in (strongly recommended before deploying) --------------------------------------
# When both are set, every page and API call asks for this username and password.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- Storage ------------------------------------------------------------------------------
# Folder for runtime files: Zoho access token, CRM fallback caches, factory meeting decisions.
# Relative paths are resolved from the backend folder. Must be writable.
DATA_DIR=.data

# --- Factory stand-up spreadsheets ---------------------------------------------------------
# Default: <DATA_DIR>/factory/<file name>. Point these at the exported sheets.
# FACTORY_PLANNING_FILE=.data/factory/Planning Query.xlsx
# FACTORY_DISPATCH_FILE=.data/factory/Dispatch Failure.xlsx
# FACTORY_CHI_FILE=.data/factory/CHI MEET REF 8 SEP26.xlsx
